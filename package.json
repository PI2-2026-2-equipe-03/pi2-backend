{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST do **TaGravado**, sistema de replay para quadras esportivas. Este repositório concentra o backend da aplicação; para o SPA, veja [pi2-frontend](https://github.com/PI2-2026-2-equipe-03/pi2-frontend). Para a visão geral do projeto (contexto, equipe, roadmap), veja [PI2-2026-2-equipe-03](https://github.com/PI2-2026-2-equipe-03/PI2-2026-2-equipe-03).",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts --reporter=verbose",
    "test:rn": "vitest run --config vitest.api.config.ts tests/regrasNegocio.test.js --reporter=verbose",
    "test:es": "vitest run --config vitest.api.config.ts tests/testesEssenciais.test.js --reporter=verbose",
    "test:n-es": "vitest run --config vitest.api.config.ts tests/testesNaoEssenciais.test.js --reporter=verbose",
    "test:watch": "vitest",
    "db:expire": "tsx src/scripts/expire-replays.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "agent:token": "tsx src/scripts/create-agent-token.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "overrides": {
    "content-disposition": "2.0.1"
  }
}
