# Referência única das variáveis. Copie para .env e preencha BETTER_AUTH_SECRET.
# Formato: [obrigatória|opcional · ambientes]. Ambientes: compose, nativo (fora do Docker), deploy (Render).
# No compose, o container recebe só o `environment` do docker-compose.yml; obrigatória ausente faz o compose falhar.
# Opcional vazia = funcionalidade desativada (503).

# --- Execução ---
# [obrigatória · nativo, deploy] fixas no compose
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# [obrigatória · compose] porta publicada no host
BACKEND_PORT=3000

# --- Banco de dados ---
# [obrigatória · compose]
POSTGRES_DB=tagravado
POSTGRES_USER=tagravado
POSTGRES_PASSWORD=tagravado-dev
# [obrigatória · compose (dev)] use 5433 se a 5432 estiver ocupada
POSTGRES_PORT=5433
# [obrigatória · nativo, deploy] fixas no compose; DB_SSL=false desliga o TLS
DATABASE_URL=postgresql://tagravado:tagravado-dev@localhost:5433/tagravado
DB_SSL=false
# [opcional · deploy] CA do Postgres gerenciado (quebras de linha como \n)
SUPABASE_CA_CERT=
# [obrigatória · todos] pools da API, do Better Auth e dos locks
DB_POOL_MAX=10
AUTH_DB_POOL_MAX=2
AUTH_LOCK_POOL_MAX=1

# --- Autenticação ---
# [obrigatória · todos] origem pública vista pelo browser
BETTER_AUTH_URL=http://localhost:5173
# [obrigatória · todos] gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# [obrigatória · todos] origens do CORS e do Better Auth, separadas por vírgula, sem barra final
CORS_ORIGINS=http://localhost:5173

# --- Integrações opcionais ---
# [opcional · todos] Bearer da rota /api/cron/expire-replays
CRON_SECRET=
# [opcional · todos] endpoint HTTPS de envio do e-mail de recuperação
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
# [opcional · todos] Cloudflare R2; endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# [obrigatória · todos] validade (s) das URLs de upload e de vídeo
UPLOAD_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=3600

# --- Testes (só na linha de comando) ---
# TEST_DATABASE_URL=postgresql://usuario@127.0.0.1:5433/postgres
# POSTMAN_RUNNER=
# API_URL=http://localhost:3000/api
# ORIGIN=http://localhost:5173
