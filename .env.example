
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
API_PORT=3000

# PostgreSQL no Docker
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Porta do Postgres no host. Mude se já tiver um Postgres rodando (ex.: 5433)
# O container sempre escuta em 5432 internamente

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
POSTGRES_PORT=5433

# Conexões da aplicação
DATABASE_URL=postgresql://user:password@localhost:5433/database
AUTH_DATABASE_URL=postgresql://user:password@localhost:5433/database
REPLAY_DATABASE_URL=postgresql://user:password@localhost:5433/database

# Better Auth
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=substitua-por-uma-chave-aleatoria-segura

# Execução nativa (fora do compose)
PORT=3000

# Adaptadores opcionais da B3-02 — configurar valores reais apenas no ambiente
# Sem e-mail, recuperação retorna 503; sem storage, fila de exclusão permanece pendente.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
MEDIA_DELETE_URL=
MEDIA_DELETE_TOKEN=
