{
  "info": {
    "name": "TaGravado — B3-02: oito rotas reais",
    "description": "Executa as oito primeiras rotas da tabela do contrato. Os dois logins de apoio exigem contas reais de gestor e administrador. Esta coleção cria registros no banco e exclui somente o replay criado na própria execução. Use banco de desenvolvimento. O download valida a URL persistida, não o conteúdo do arquivo de mídia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "B302@Teste2026",
      "type": "string"
    },
    {
      "key": "managerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "courtId",
      "value": "",
      "type": "string"
    },
    {
      "key": "availableReplayId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Cadastro real",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Usuário Postman\",\n  \"email\": \"b302-{{runId}}@example.test\",\n  \"phone\": \"85{{runId}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"UUID persistido e senha omitida\", () => { pm.expect(pm.response.json().id).to.be.a(\"string\"); pm.expect(pm.response.json()).not.to.have.property(\"password\"); });"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Login real",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"b302-{{runId}}@example.test\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"userToken\", pm.response.json().token);",
              "pm.test(\"Sessão de 30 minutos\", () => pm.expect(pm.response.json().expiresIn).to.equal(1800));"
            ]
          }
        }
      ]
    },
    {
      "name": "Apoio — Login do gestor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{managerEmail}}\",\n  \"password\": \"{{managerPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"managerToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Apoio — Login do administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Métricas do administrador",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/metrics",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Contagens reais\", () => pm.expect(pm.response.json().totalCourts).to.be.a(\"number\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Métricas do gestor",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/manager/metrics",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Quadras do gestor\", () => pm.expect(pm.response.json().courts).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Patrocinador com vínculo real",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/sponsors",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Patrocinador {{runId}}\",\n  \"imageUrl\": \"https://example.com/logo.png\",\n  \"duration\": 10,\n  \"value\": 500,\n  \"courtIds\": [\n    \"{{courtId}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Vínculo persistido\", () => pm.expect(pm.response.json().courtIds).to.include(pm.variables.get(\"courtId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Solicitação de replay",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/replays",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courtId\": \"{{courtId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"createdReplayId\", pm.response.json().data.id);",
              "pm.test(\"Pendente até processamento real\", () => pm.expect(pm.response.json().data.status).to.equal(\"pendente\"));",
              "pm.test(\"Janela de 30 segundos\", () => pm.expect(pm.response.json().data.duration).to.equal(30));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Download de replay disponível",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/replays/{{availableReplayId}}/download",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"URL vinda do banco\", () => pm.expect(pm.response.json().data.downloadUrl).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 — Exclusão auditada",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/replays/{{createdReplayId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Teste funcional B3-02 pelo Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
